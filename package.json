{
  "name": "metamorph",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm build && node --test packages/contracts/test/contracts.test.mjs apps/server/test/health.test.mjs packages/agent/test/*.test.mjs packages/oracle/test/oracle.test.mjs packages/integration/test/*.test.mjs packages/agent-real/test/*.test.mjs",
    "build": "pnpm -r build",
    "start": "pnpm --filter @metamorph/server start",
    "demo:agent": "pnpm build && pnpm --filter @metamorph/agent demo",
    "demo:integration": "pnpm build && pnpm --filter @metamorph/integration demo"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
