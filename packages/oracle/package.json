{
  "name": "@metamorph/oracle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "controls": "node test/run-controls.mjs",
    "test:reference": "pnpm --filter @metamorph/oracle... build && node --test reference/reference.test.mjs",
    "reference:proof": "node reference/proof.mjs"
  },
  "dependencies": {
    "@metamorph/contracts": "workspace:*"
  }
}
