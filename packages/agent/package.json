{
  "name": "@metamorph/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node dist/demo.js",
    "test": "node --test test/*.test.mjs",
    "meta:preflight": "node dist/meta-cli.js preflight",
    "live:probe": "node dist/meta-cli.js probe"
  },
  "dependencies": {
    "@metamorph/contracts": "workspace:*",
    "zod": "4.6.7"
  }
}
